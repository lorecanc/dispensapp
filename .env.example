# Copia in .env (mai committare credenziali reali). Vedi backend/README.md e wiki/config/backend-config.md.
# Scrittura OFF: staging world.openfoodfacts.net di default. Su staging usare un
# account creato sullo staging (OFF_USER/OFF_PASS), non quello di produzione.
OFF_WRITE_ENABLED=false
OFF_WRITE_BASE_URL=https://world.openfoodfacts.net/cgi
OFF_USER=
OFF_PASS=
# Basic auth dello staging OFF (host protetto): solo staging, default off:off.
OFF_STAGING_BASIC_USER=off
OFF_STAGING_BASIC_PASS=off
# User-Agent "App/Version (contact)": nome/versione app + email di contatto.
OFF_APP_NAME=DispensApp
OFF_APP_VERSION=0.1.0
OFF_CONTACT_EMAIL=
